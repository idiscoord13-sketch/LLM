# Copy to .env and fill in. NEVER commit .env.
# Hugging Face token (gated models / private datasets)
HF_TOKEN=
# Weights & Biases (optional experiment tracking)
WANDB_API_KEY=
WANDB_PROJECT=myllm
# Teacher / judge endpoints (OpenAI-compatible: vLLM, SGLang, Ollama, ...)
TEACHER_BASE_URL=http://localhost:8001/v1
TEACHER_API_KEY=
JUDGE_BASE_URL=http://localhost:8002/v1
JUDGE_API_KEY=
# Gateway: comma-separated API keys allowed to call the public endpoint
GATEWAY_API_KEYS=change-me-long-random-key
# Upstream model server the gateway proxies to (vLLM/Ollama OpenAI endpoint)
UPSTREAM_BASE_URL=http://localhost:8000/v1
UPSTREAM_API_KEY=
